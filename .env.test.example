# E2E test environment variables — copy to .env.test and fill in values.
# Run: cp .env.test.example .env.test && npx vitest run src/__tests__/e2e/

# API base URL (default: production API)
E2E_API_URL=https://api.cachly.dev

# Valid Keycloak JWT or long-lived API key (cky_live_...)
# Get from: cachly.dev/instances → Settings → API Token
E2E_JWT=

# UUID of an active (running) Brain instance for this token
E2E_INSTANCE_ID=

# Redis password for the test instance (from connection details)
E2E_API_KEY=

# Redis host and port for the test instance
E2E_REDIS_HOST=
E2E_REDIS_PORT=6380
E2E_REDIS_TLS=true

# Set to "true" to skip slow tests (provisioning, device flow)
E2E_SKIP_SLOW=false
