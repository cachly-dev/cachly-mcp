{
  "name": "@cachly-dev/mcp-server",
  "version": "0.10.137",
  "mcpName": "io.github.cachly-dev/mcp-server",
  "description": "Your AI forgets everything between sessions. cachly fixes that permanently: 123 MCP tools for Claude Code, Cursor, Copilot & Windsurf. Learns from every bug fix, commit and CI run. Arrives pre-briefed. Free tier forever, EU servers, GDPR.",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/src/**/*.js",
    "dist/packages/**/*.js",
    "scripts/postinstall.js",
    "server.json",
    "glama.json"
  ],
  "bin": {
    "cachly-mcp": "dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "scripts": {
    "count-tools": "node scripts/count-tools.mjs",
    "tool-catalog": "node scripts/tool-catalog.mjs summary",
    "tool-catalog:json": "node scripts/tool-catalog.mjs json",
    "tool-catalog:markdown": "node scripts/tool-catalog.mjs markdown",
    "capability-docs": "node scripts/capability-docs.mjs markdown",
    "capability-docs:write": "node scripts/capability-docs.mjs write",
    "verify-capability-docs": "node scripts/capability-docs.mjs check",
    "docs-atlas": "node scripts/docs-atlas.mjs summary",
    "docs-atlas:write": "node scripts/docs-atlas.mjs write",
    "verify-docs-atlas": "node scripts/docs-atlas.mjs check",
    "tool-spec-snapshots:write": "node scripts/tool-spec-snapshots.mjs write",
    "version": "node scripts/nummer-nachziehen.mjs && npm run tool-spec-snapshots:write",
    "verify-tool-spec-snapshots": "node scripts/tool-spec-snapshots.mjs check",
    "verify-tool-counts": "node scripts/verify-tool-counts.mjs",
    "verify-capabilities": "node scripts/verify-capabilities.mjs",
    "build": "tsc && node scripts/paket-schliessen.mjs && node scripts/bauabdruck.mjs",
    "postinstall": "node scripts/postinstall.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/bench/echter-korpus.ts",
    "bench:spielzeug": "tsx src/bench/cachly-bench.ts",
    "bench:external": "tsx src/bench/external-corpus.ts",
    "bench:onboarding": "tsx src/bench/onboarding-bench.ts",
    "bench:gate": "tsx src/bench/gate.ts",
    "test:e2e": "bash scripts/e2e-run.sh",
    "test:e2e:api": "bash scripts/e2e-run.sh api",
    "test:e2e:cli": "bash scripts/e2e-run.sh cli",
    "test:e2e:tools": "bash scripts/e2e-run.sh tools",
    "test:e2e:funnel": "bash scripts/e2e-run.sh funnel",
    "test:e2e:provisioning": "bash scripts/e2e-run.sh provisioning",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "bench:cost": "tsx src/bench/cost.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "gpt-tokenizer": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachly-dev/cachly-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-memory",
    "persistent-memory",
    "claude-code-memory",
    "claude",
    "claude-code",
    "cursor",
    "cursor-memory",
    "copilot",
    "github-copilot",
    "windsurf",
    "cline",
    "zed",
    "continue",
    "ai-brain",
    "brain",
    "causal-knowledge-graph",
    "causal-trace",
    "root-cause-analysis",
    "failure-prediction",
    "brain-predict",
    "smart-recall",
    "memory-crystals",
    "team-knowledge",
    "ambient-git",
    "continuous-learning",
    "lessons-learned",
    "session-memory",
    "semantic-cache",
    "semantic-search",
    "predictive-ai",
    "developer-productivity",
    "knowledge-base",
    "knowledge-graph",
    "ai-context",
    "context-window",
    "long-term-memory",
    "llm-memory",
    "cachly",
    "redis",
    "valkey",
    "cache",
    "ai",
    "llm",
    "gdpr",
    "ckg"
  ],
  "homepage": "https://cachly.dev/docs/mcp",
  "bugs": {
    "url": "https://github.com/cachly-dev/cachly-mcp/issues"
  }
}
