{
  "name": "@cachly-dev/mcp-server",
  "version": "0.10.73",
  "mcpName": "io.github.cachly-dev/cachly-mcp",
  "description": "Your AI forgets everything between sessions. cachly fixes that permanently. Persistent memory + causal root-cause analysis for Claude Code, Cursor, Copilot & Windsurf. Learns from every bug fix, git commit, and CI run automatically. Arrives pre-briefed. Predicts failures before they happen. 107 MCP tools · Free tier forever · GDPR · EU servers.",
  "type": "module",
  "files": [
    "dist/src/**/*",
    "dist/packages/**/*",
    "scripts/postinstall.js",
    "server.json"
  ],
  "bin": {
    "cachly-mcp": "dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "scripts": {
    "count-tools": "grep -c \"name: '\" src/tools.ts",
    "build": "tsc",
    "postinstall": "node scripts/postinstall.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/bench/cachly-bench.ts",
    "bench:external": "tsx src/bench/external-corpus.ts",
    "test:e2e": "bash scripts/e2e-run.sh",
    "test:e2e:api": "bash scripts/e2e-run.sh api",
    "test:e2e:cli": "bash scripts/e2e-run.sh cli",
    "test:e2e:tools": "bash scripts/e2e-run.sh tools",
    "test:e2e:funnel": "bash scripts/e2e-run.sh funnel",
    "test:e2e:provisioning": "bash scripts/e2e-run.sh provisioning",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachly-dev/cachly-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-memory",
    "persistent-memory",
    "claude-code-memory",
    "claude",
    "claude-code",
    "cursor",
    "cursor-memory",
    "copilot",
    "github-copilot",
    "windsurf",
    "cline",
    "zed",
    "continue",
    "ai-brain",
    "brain",
    "causal-knowledge-graph",
    "causal-trace",
    "root-cause-analysis",
    "failure-prediction",
    "brain-predict",
    "smart-recall",
    "memory-crystals",
    "team-knowledge",
    "ambient-git",
    "continuous-learning",
    "lessons-learned",
    "session-memory",
    "semantic-cache",
    "semantic-search",
    "predictive-ai",
    "developer-productivity",
    "knowledge-base",
    "knowledge-graph",
    "ai-context",
    "context-window",
    "long-term-memory",
    "llm-memory",
    "cachly",
    "redis",
    "valkey",
    "cache",
    "ai",
    "llm",
    "gdpr",
    "ckg"
  ],
  "homepage": "https://cachly.dev/docs/mcp",
  "bugs": {
    "url": "https://github.com/cachly-dev/cachly-mcp/issues"
  }
}
