# ═══════════════════════════════════════════════════════════════
#  Travel Chaos Organizer — Production Environment
#  Copy to .env and fill in ALL values marked with ← REQUIRED
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
UPLOAD_DIR=/data/uploads

# ── Database ─────────────────────────────────────────────────────
# Set automatically by docker-compose — change only for external DB
DATABASE_URL=postgresql+asyncpg://tco:tco@postgres:5432/tco

# ── Keycloak ─────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=travel-chaos
KEYCLOAK_CLIENT_ID=tco-backend

# ── Ollama AI ────────────────────────────────────────────────────
OLLAMA_URL=http://YOUR_OLLAMA_HOST:11434        # ← REQUIRED
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT=120

# ── Cachly Redis Cache ───────────────────────────────────────────
# Local Redis (auto-configured by docker-compose):
CACHLY_REDIS_URL=redis://redis:6379/0
# Production Cachly instance (replaces local Redis — faster, managed):
# CACHLY_REDIS_URL=redis://:<password>@<host>.cachly.dev:6380/0  # ← RECOMMENDED

# ── Admin Dashboard ──────────────────────────────────────────────
ADMIN_USER=admin                                # ← CHANGE THIS
ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS           # ← REQUIRED — min 16 chars

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated origins or * for all
CORS_ORIGINS=*

# ── Stripe Payments ──────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=                              # ← REQUIRED for payments
STRIPE_WEBHOOK_SECRET=                          # ← REQUIRED for webhooks (whsec_...)
STRIPE_PRO_PRICE_ID=                            # ← REQUIRED (price_...)
STRIPE_SUCCESS_URL=https://YOUR_DOMAIN/upgrade/success
STRIPE_CANCEL_URL=https://YOUR_DOMAIN/upgrade/cancel

# ── Email — Resend ───────────────────────────────────────────────
# Get API key at https://resend.com
RESEND_API_KEY=                                 # ← REQUIRED for email
RESEND_FROM=noreply@YOUR_DOMAIN.com             # ← REQUIRED — verified sender

# ── Telegram Notifications ───────────────────────────────────────
# 1. Create bot via @BotFather → get token
# 2. Add bot to channel → get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=                             # ← RECOMMENDED
TCO_TELEGRAM_CHAT_ID=                           # ← RECOMMENDED

# ── Sentry Error Tracking ────────────────────────────────────────
# Create project at https://sentry.io
SENTRY_DSN=                                     # ← RECOMMENDED
