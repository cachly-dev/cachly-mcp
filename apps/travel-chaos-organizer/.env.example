# Travel Chaos Organizer — Environment Variables
# Copy to .env and fill in your values

# App
DEBUG=false
UPLOAD_DIR=/data/uploads

# Database (overridden by docker-compose for containerized runs)
DATABASE_URL=postgresql+asyncpg://tco:tco@localhost:5432/tco

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=travel-chaos
KEYCLOAK_CLIENT_ID=tco-backend

# Ollama — point to your self-hosted instance
OLLAMA_URL=http://your-server:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT=120

# Cachly Redis — caches Ollama parse results to avoid duplicate AI calls.
# docker-compose sets this automatically (local Redis).
# In production, replace with your Cachly instance URL:
#   cachly.dev → Instances → Connection String
# Same document uploaded twice? Instant response from cache, no second AI call.
CACHLY_REDIS_URL=redis://localhost:6379/0
# CACHLY_REDIS_URL=redis://:<password>@<host>.cachly.dev:6380/0

# Telegram Notifier (optional) — get token from @BotFather
# TELEGRAM_BOT_TOKEN=...
# TCO_TELEGRAM_CHAT_ID=...   # chat or channel ID for TCO events

# Email — Resend (optional, https://resend.com)
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@yourdomain.com

# Admin dashboard (change before going live!)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
STRIPE_SUCCESS_URL=https://YOUR_DOMAIN/upgrade/success
STRIPE_CANCEL_URL=https://YOUR_DOMAIN/upgrade/cancel
