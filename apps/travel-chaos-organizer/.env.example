# Travel Chaos Organizer — Environment Variables
# Copy to .env and fill in your values

# App
DEBUG=false
UPLOAD_DIR=/data/uploads

# Database (overridden by docker-compose for containerized runs)
DATABASE_URL=postgresql+asyncpg://tco:tco@localhost:5432/tco

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=travel-chaos
KEYCLOAK_CLIENT_ID=tco-backend

# Ollama — point to your self-hosted instance
OLLAMA_URL=http://your-server:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT=120

# Cachly Redis (optional) — caches Ollama parse results to avoid duplicate AI calls.
# Get your Redis URL from cachly.dev → Instances → Connection String
# Same document uploaded twice? Instant response from cache, no second AI call.
# CACHLY_REDIS_URL=redis://:<password>@<host>.cachly.dev:6380/0
