# Travel Chaos Organizer — Caddyfile
# Set TCO_DOMAIN in .env (e.g. TCO_DOMAIN=tco.example.com)

{$TCO_DOMAIN:localhost} {
    reverse_proxy backend:8000

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}

# Local HTTP fallback (always active)
:8080 {
    reverse_proxy backend:8000
    encode gzip
}
