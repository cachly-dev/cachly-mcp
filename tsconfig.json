{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "apps",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/bench/**"
  ]
}
